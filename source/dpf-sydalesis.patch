+// --------------------------------------------------------------------------------------------------------------------
+// Driftfield patch: dpf_note_expression (VST3 INoteExpressionController)
+// Advertises the six standard note-expression types; the values reach the plugin as 12-byte MIDI events
+// starting with 0xF4 (see InputEventList::appendNoteExpression).
+
+#include "travesty/align_push.h"
+struct v3_note_expression_value_description {
+    double default_value, minimum, maximum;
+    int32_t step_count;
+};
+struct v3_note_expression_type_info {
+    uint32_t type_id;
+    v3_str_128 title, short_title, units;
+    int32_t unit_id;
+    v3_note_expression_value_description value_desc;
+    v3_param_id associated_parameter_id;
+    int32_t flags;
+};
+struct v3_note_expression_controller {
+    int32_t (V3_API* get_note_expression_count)(void* self, int32_t bus, int16_t channel);
+    v3_result (V3_API* get_note_expression_info)(void* self, int32_t bus, int16_t channel, int32_t index, v3_note_expression_type_info* info);
+    v3_result (V3_API* get_note_expression_string_by_value)(void* self, int32_t bus, int16_t channel, uint32_t id, double value, v3_str_128 str);
+    v3_result (V3_API* get_note_expression_value_by_string)(void* self, int32_t bus, int16_t channel, uint32_t id, const int16_t* str, double* value);
+};
+#include "travesty/align_pop.h"
+static constexpr const v3_tuid v3_note_expression_controller_iid =
+    V3_ID(0xB7F8F859, 0x41234872, 0x91169581, 0x4F3721A3);
+struct v3_note_expression_controller_cpp : v3_funknown {
+    v3_note_expression_controller ne;
+};
+static_assert(sizeof(v3_note_expression_type_info) == 816, "NoteExpressionTypeInfo layout");
+
+struct dpf_note_expression : v3_note_expression_controller_cpp {
+    dpf_note_expression()
+    {
+        query_interface = query_interface_note_expression;
+        ref = dpf_static_ref;
+        unref = dpf_static_unref;
+        ne.get_note_expression_count = get_note_expression_count;
+        ne.get_note_expression_info = get_note_expression_info;
+        ne.get_note_expression_string_by_value = get_note_expression_string_by_value;
+        ne.get_note_expression_value_by_string = get_note_expression_value_by_string;
+    }
+    static v3_result V3_API query_interface_note_expression(void* const self, const v3_tuid iid, void** const iface)
+    {
+        if (v3_tuid_match(iid, v3_funknown_iid) || v3_tuid_match(iid, v3_note_expression_controller_iid))
+        {
+            *iface = self;
+            return V3_OK;
+        }
+        *iface = nullptr;
+        return V3_NO_INTERFACE;
+    }
+    struct Def { uint32_t id; const char* title; const char* shortTitle; const char* units; double def, mn, mx; int32_t flags; };
+    static const Def* defs()
+    {
+        // flags: 1 bipolar, 4 absolute
+        static const Def d[6] = {
+            { 0, "Volume", "Vol", "dB", 0.25, 0.0, 1.0, 4 },
+            { 1, "Pan", "Pan", "", 0.5, 0.0, 1.0, 1 | 4 },
+            { 2, "Tuning", "Tune", "semitones", 0.5, 0.0, 1.0, 1 | 4 },
+            { 3, "Vibrato", "Vib", "", 0.0, 0.0, 1.0, 4 },
+            { 4, "Expression", "Expr", "", 0.0, 0.0, 1.0, 4 },
+            { 5, "Brightness", "Bright", "", 0.5, 0.0, 1.0, 1 | 4 },
+        };
+        return d;
+    }
+    static void putStr(v3_str_128 dst, const char* src)
+    {
+        int i = 0;
+        for (; src[i] != '\0' && i < 127; ++i) dst[i] = (int16_t)(uint8_t)src[i];
+        dst[i] = 0;
+    }
+    static int32_t V3_API get_note_expression_count(void*, int32_t bus, int16_t)
+    {
+        return bus == 0 ? 6 : 0;
+    }
+    static v3_result V3_API get_note_expression_info(void*, int32_t bus, int16_t, int32_t index, v3_note_expression_type_info* const info)
+    {
+        if (bus != 0 || index < 0 || index >= 6 || info == nullptr) return V3_INVALID_ARG;
+        const Def& d(defs()[index]);
+        std::memset(info, 0, sizeof(*info));
+        info->type_id = d.id;
+        putStr(info->title, d.title);
+        putStr(info->short_title, d.shortTitle);
+        putStr(info->units, d.units);
+        info->unit_id = -1;
+        info->value_desc.default_value = d.def;
+        info->value_desc.minimum = d.mn;
+        info->value_desc.maximum = d.mx;
+        info->value_desc.step_count = 0;
+        info->associated_parameter_id = 0xffffffffu;
+        info->flags = d.flags;
+        return V3_OK;
+    }
+    static v3_result V3_API get_note_expression_string_by_value(void*, int32_t, int16_t, uint32_t id, double v, v3_str_128 str)
+    {
+        char buf[64];
+        switch (id)
+        {
+        case 0: std::snprintf(buf, sizeof(buf), "%.1f dB", v > 0.0 ? 20.0 * std::log10(4.0 * v) : -144.0); break;
+        case 1: std::snprintf(buf, sizeof(buf), "%.0f%%", (v - 0.5) * 200.0); break;
+        case 2: std::snprintf(buf, sizeof(buf), "%+.2f st", (v - 0.5) * 240.0); break;
+        default: std::snprintf(buf, sizeof(buf), "%.0f%%", v * 100.0); break;
+        }
+        putStr(str, buf);
+        return V3_OK;
+    }
+    static v3_result V3_API get_note_expression_value_by_string(void*, int32_t, int16_t, uint32_t, const int16_t*, double*)
+    {
+        return V3_NOT_IMPLEMENTED;
+    }
+    DISTRHO_PREVENT_HEAP_ALLOCATION
+};
